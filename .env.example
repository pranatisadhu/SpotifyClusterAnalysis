# Last.fm API credentials
# Register at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_API_SECRET=your_lastfm_api_secret_here
LASTFM_USERNAME=your_lastfm_username_here
LASTFM_PASSWORD_HASH=your_lastfm_password_hash_here  # use pylast.md5("your_password")

# Spotify API credentials
# Register at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional: Spotify redirect URI (needed only for user auth flows; not required here)
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
